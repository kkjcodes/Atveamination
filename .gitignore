!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.crt
*.cer

# editor / local tooling
.idea/
.vscode/
settings.local.json

# claude code project files (memory, settings)
.claude/
memory/

# azure local
.azure/

# local asset source folders — source-of-truth assets get processed into
# /public/... (small, shipped) via a curate script; raw sources stay local.
/images/
# Raw music source MP3s (60MB+). Curated 45s trims land in public/business/music/.
/music/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore all, but keep the example template
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# Local test photos (PII / EXIF GPS) and personal notes
Testing/
Episodes.md

# Personal / launch material — not for the public repo
nextsteps.md
advertising.md
GOOGLE-SEARCH-SETUP.md
/Scrapbook Plan/

